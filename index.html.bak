<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="PME CONSULTANCE — Cabinet d'expertise comptable et de conseil 100% en ligne. Création d'entreprise, micro-entrepreneur, bilan annuel TPE. Devis instantané en 60 secondes." />
<meta name="keywords" content="expert comptable en ligne, création entreprise, micro-entrepreneur, bilan annuel TPE, cabinet expertise comptable, comptabilité PME" />
<meta name="author" content="PME CONSULTANCE" />
<meta property="og:title" content="PME CONSULTANCE — Expertise comptable & conseil pour TPE/PME" />
<meta property="og:description" content="Cabinet d'expertise comptable 100% en ligne. Devis instantané. Tarifs transparents." />
<meta property="og:type" content="website" />
<title>PME CONSULTANCE — Expertise · Conseils · Disruption · Valeur Ajoutée</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --ivoire:#F5F1E8;
  --ivoire-clair:#FAF7F0;
  --ivoire-fonce:#EDE7D7;
  --noir:#1A1A1A;
  --anthracite:#2C2C2C;
  --gris-texte:#5C5C5C;
  --gris-clair:#9A958A;
  --or:#B8985A;
  --or-fonce:#9A7E48;
  --marine:#0E1B2C;
  --blanc:#FFFFFF;
  --ombre:0 4px 30px rgba(26,26,26,0.06);
  --ombre-hover:0 12px 40px rgba(26,26,26,0.12);
  --transition:cubic-bezier(0.4,0,0.2,1);
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;font-size:16px}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--ivoire);
  color:var(--noir);
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

h1,h2,h3,h4{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;letter-spacing:.01em;line-height:1.15;color:var(--noir)}
h1{font-size:clamp(2.4rem,5.5vw,4.5rem)}
h2{font-size:clamp(1.9rem,3.8vw,3rem)}
h3{font-size:clamp(1.3rem,2.2vw,1.7rem)}
.italique{font-style:italic;color:var(--gris-texte)}

a{color:inherit;text-decoration:none;transition:color .3s var(--transition)}
img{max-width:100%;display:block}
.container{max-width:1240px;margin:0 auto;padding:0 32px}
.section{padding:110px 0}
.section-titre{text-align:center;margin-bottom:70px}
.section-titre .surtitre{
  font-family:'Inter',sans-serif;font-size:.78rem;font-weight:500;
  letter-spacing:.32em;text-transform:uppercase;color:var(--or);
  margin-bottom:18px;display:block;
}
.section-titre h2{margin-bottom:18px}
.section-titre p{font-size:1.05rem;color:var(--gris-texte);max-width:640px;margin:0 auto}

.header{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(245,241,232,0.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(184,152,90,0.12);transition:all .4s var(--transition)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:80px}
.logo{display:flex;align-items:center;gap:12px;height:55px}
.logo img{height:48px;width:auto;object-fit:contain}
.nav{display:flex;align-items:center;gap:42px}
.nav a{font-size:.9rem;font-weight:400;color:var(--anthracite);position:relative}
.nav a:hover{color:var(--or)}
.nav a::after{content:'';position:absolute;bottom:-6px;left:0;width:0;height:1px;background:var(--or);transition:width .3s var(--transition)}
.nav a:hover::after{width:100%}
.btn-header{background:var(--noir);color:var(--ivoire);padding:13px 28px;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;border:1px solid var(--noir);transition:all .35s var(--transition)}
.btn-header:hover{background:var(--or);border-color:var(--or);color:var(--blanc)}
.menu-mobile{display:none;background:none;border:none;cursor:pointer;font-size:1.5rem;color:var(--noir)}

.hero{min-height:100vh;padding:140px 0 80px;display:flex;align-items:center;background:radial-gradient(ellipse at top right,rgba(184,152,90,0.05) 0%,transparent 60%),var(--ivoire);position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:50%;right:-200px;width:700px;height:700px;border-radius:50%;border:1px solid rgba(184,152,90,0.08);transform:translateY(-50%)}
.hero::after{content:'';position:absolute;top:50%;right:-100px;width:500px;height:500px;border-radius:50%;border:1px solid rgba(184,152,90,0.05);transform:translateY(-50%)}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:center;position:relative;z-index:2}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.78rem;letter-spacing:.32em;text-transform:uppercase;color:var(--or);margin-bottom:28px;font-weight:500}
.hero-eyebrow::before{content:'';width:30px;height:1px;background:var(--or)}
.hero h1{margin-bottom:28px}
.hero h1 em{color:var(--or);font-style:italic;font-weight:300}
.hero-sous{font-size:1.15rem;color:var(--gris-texte);margin-bottom:42px;max-width:520px;line-height:1.75}
.hero-cta{display:flex;gap:18px;flex-wrap:wrap}
.btn-primaire{display:inline-flex;align-items:center;gap:14px;background:var(--noir);color:var(--ivoire);padding:18px 36px;font-size:.92rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--noir);cursor:pointer;transition:all .4s var(--transition)}
.btn-primaire:hover{background:var(--or);border-color:var(--or);transform:translateY(-2px);box-shadow:0 12px 30px rgba(184,152,90,0.3)}
.btn-primaire .arrow{transition:transform .3s var(--transition)}
.btn-primaire:hover .arrow{transform:translateX(6px)}
.btn-secondaire{display:inline-flex;align-items:center;gap:14px;background:transparent;color:var(--noir);padding:18px 36px;font-size:.92rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--noir);cursor:pointer;transition:all .4s var(--transition)}
.btn-secondaire:hover{background:var(--noir);color:var(--ivoire)}

.hero-trust{margin-top:50px;display:flex;align-items:center;gap:30px;flex-wrap:wrap}
.hero-trust-item{display:flex;align-items:center;gap:10px;font-size:.85rem;color:var(--gris-texte)}
.hero-trust-item svg{flex-shrink:0;color:var(--or)}

.hero-visual{position:relative;height:560px;display:flex;align-items:center;justify-content:center}
.hero-card{position:absolute;background:var(--blanc);padding:32px;border:1px solid rgba(184,152,90,0.15);box-shadow:var(--ombre);transition:transform .4s var(--transition)}
.hero-card-1{top:0;left:0;width:280px;animation:flotter 6s ease-in-out infinite}
.hero-card-2{bottom:30px;right:0;width:300px;animation:flotter 6s ease-in-out infinite .8s}
.hero-card-3{top:50%;left:30%;width:260px;background:var(--noir);color:var(--ivoire)}
@keyframes flotter{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.hero-card-3{animation:flotter-center 6s ease-in-out infinite 1.6s}
@keyframes flotter-center{0%,100%{transform:translateY(-50%)}50%{transform:translateY(calc(-50% - 12px))}}
.hero-card .num{font-family:'Cormorant Garamond',serif;font-size:2.8rem;color:var(--or);line-height:1;margin-bottom:8px}
.hero-card .label{font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gris-texte)}
.hero-card-3 .label{color:var(--ivoire-fonce)}
.hero-card .desc{font-size:.85rem;margin-top:12px;color:var(--gris-texte)}
.hero-card-3 .desc{color:rgba(245,241,232,0.7)}

.confiance{padding:50px 0;background:var(--ivoire-fonce);border-top:1px solid rgba(184,152,90,0.12);border-bottom:1px solid rgba(184,152,90,0.12)}
.confiance-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px;align-items:center}
.confiance-item{text-align:center}
.confiance-item .pict{font-size:1.8rem;color:var(--or);margin-bottom:10px}
.confiance-item h4{font-family:'Inter',sans-serif;font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;color:var(--noir);font-weight:500;margin-bottom:6px}
.confiance-item p{font-size:.85rem;color:var(--gris-texte)}

.offres{background:var(--ivoire);position:relative}
.offres-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
.offre{background:var(--blanc);padding:48px 38px;border:1px solid rgba(26,26,26,0.06);position:relative;transition:all .5s var(--transition);display:flex;flex-direction:column}
.offre:hover{transform:translateY(-8px);box-shadow:var(--ombre-hover);border-color:var(--or)}
.offre.populaire{border:2px solid var(--or);transform:scale(1.03)}
.offre.populaire:hover{transform:scale(1.03) translateY(-8px)}
.offre.populaire .badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--or);color:var(--blanc);padding:6px 22px;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:500}
.offre-icone{width:64px;height:64px;border-radius:50%;background:var(--ivoire);display:flex;align-items:center;justify-content:center;margin-bottom:24px;color:var(--or)}
.offre h3{margin-bottom:10px}
.offre .accroche{font-size:.92rem;color:var(--gris-texte);margin-bottom:30px;font-style:italic;min-height:48px}
.offre .prix{margin-bottom:30px;padding-bottom:30px;border-bottom:1px solid rgba(26,26,26,0.08)}
.offre .prix-montant{font-family:'Cormorant Garamond',serif;font-size:3.2rem;color:var(--noir);line-height:1}
.offre .prix-montant .euro{font-size:1.6rem;vertical-align:top;margin-right:4px;color:var(--or)}
.offre .prix-montant .periode{font-size:.95rem;color:var(--gris-texte);font-family:'Inter',sans-serif;margin-left:6px}
.offre .prix-mention{font-size:.78rem;color:var(--gris-clair);margin-top:8px;letter-spacing:.04em}
.offre ul{list-style:none;margin-bottom:36px;flex-grow:1}
.offre li{padding:10px 0 10px 30px;position:relative;font-size:.92rem;color:var(--anthracite);border-bottom:1px solid rgba(26,26,26,0.04)}
.offre li:last-child{border-bottom:none}
.offre li::before{content:'';position:absolute;left:0;top:18px;width:14px;height:8px;border-left:1.5px solid var(--or);border-bottom:1.5px solid var(--or);transform:rotate(-45deg)}
.offre .btn-offre{width:100%;padding:16px;background:transparent;color:var(--noir);border:1px solid var(--noir);font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:all .35s var(--transition)}
.offre .btn-offre:hover{background:var(--noir);color:var(--ivoire)}
.offre.populaire .btn-offre{background:var(--noir);color:var(--ivoire)}
.offre.populaire .btn-offre:hover{background:var(--or);border-color:var(--or)}

.offres-note{text-align:center;margin-top:50px;font-size:.9rem;color:var(--gris-texte)}
.offres-note a{color:var(--or);text-decoration:underline;text-underline-offset:4px}

.pourquoi{background:var(--marine);color:var(--ivoire-clair);position:relative;overflow:hidden}
.pourquoi::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--or),transparent)}
.pourquoi h2{color:var(--ivoire-clair)}
.pourquoi .section-titre p{color:rgba(245,241,232,0.7)}
.pourquoi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:50px}
.pourquoi-item{text-align:center}
.pourquoi-item .num{font-family:'Cormorant Garamond',serif;font-size:3.5rem;color:var(--or);line-height:1;margin-bottom:20px;font-style:italic}
.pourquoi-item h3{color:var(--ivoire-clair);margin-bottom:14px;font-style:italic}
.pourquoi-item p{font-size:.95rem;color:rgba(245,241,232,0.65);line-height:1.75}

.processus{background:var(--ivoire-clair)}
.processus-timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;position:relative}
.processus-timeline::before{content:'';position:absolute;top:30px;left:8%;right:8%;height:1px;background:linear-gradient(90deg,transparent,var(--or) 15%,var(--or) 85%,transparent);z-index:0}
.etape{text-align:center;position:relative;z-index:1}
.etape .cercle{width:60px;height:60px;border-radius:50%;background:var(--ivoire);border:2px solid var(--or);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-family:'Cormorant Garamond',serif;font-size:1.6rem;color:var(--or);font-weight:500}
.etape h4{font-family:'Cormorant Garamond',serif;font-size:1.3rem;margin-bottom:10px}
.etape p{font-size:.9rem;color:var(--gris-texte);padding:0 10px}

.temoignages{background:var(--ivoire)}
.temoignages-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
.temoignage{background:var(--blanc);padding:42px 36px;border:1px solid rgba(26,26,26,0.06);position:relative}
.temoignage::before{content:'\201C';position:absolute;top:10px;left:20px;font-family:'Cormorant Garamond',serif;font-size:5rem;color:var(--or);opacity:.3;line-height:1}
.temoignage .etoiles{color:var(--or);margin-bottom:20px;font-size:1rem;letter-spacing:2px;position:relative;z-index:1}
.temoignage p{font-size:1.02rem;color:var(--anthracite);font-style:italic;margin-bottom:28px;line-height:1.75;position:relative;z-index:1;font-family:'Cormorant Garamond',serif;font-weight:400}
.temoignage .auteur{display:flex;align-items:center;gap:14px;padding-top:24px;border-top:1px solid rgba(184,152,90,0.15)}
.temoignage .avatar{width:48px;height:48px;border-radius:50%;background:var(--ivoire-fonce);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;color:var(--or);font-size:1.1rem;font-weight:500}
.temoignage .nom{font-size:.95rem;font-weight:500;color:var(--noir)}
.temoignage .role{font-size:.82rem;color:var(--gris-texte)}

.devis{background:var(--noir);color:var(--ivoire);position:relative;overflow:hidden}
.devis::before{content:'';position:absolute;top:50%;left:-200px;width:500px;height:500px;border-radius:50%;border:1px solid rgba(184,152,90,0.15);transform:translateY(-50%)}
.devis::after{content:'';position:absolute;top:50%;right:-300px;width:600px;height:600px;border-radius:50%;border:1px solid rgba(184,152,90,0.08);transform:translateY(-50%)}
.devis h2{color:var(--ivoire)}
.devis .section-titre p{color:rgba(245,241,232,0.7)}
.devis .section-titre .surtitre{color:var(--or)}
.devis-card{max-width:780px;margin:0 auto;background:var(--blanc);color:var(--noir);padding:60px 70px;position:relative;z-index:2;box-shadow:0 30px 80px rgba(0,0,0,0.3)}
.devis-progress{display:flex;justify-content:space-between;margin-bottom:50px;position:relative}
.devis-progress::before{content:'';position:absolute;top:14px;left:14px;right:14px;height:1px;background:rgba(26,26,26,0.1);z-index:0}
.devis-progress-fill{position:absolute;top:14px;left:14px;height:1px;background:var(--or);z-index:1;transition:width .5s var(--transition)}
.progress-step{display:flex;flex-direction:column;align-items:center;gap:10px;position:relative;z-index:2;background:var(--blanc);padding:0 8px}
.progress-step .puce{width:28px;height:28px;border-radius:50%;background:var(--ivoire-fonce);border:1px solid rgba(26,26,26,0.15);display:flex;align-items:center;justify-content:center;font-size:.78rem;color:var(--gris-texte);transition:all .4s var(--transition)}
.progress-step.active .puce,.progress-step.done .puce{background:var(--or);border-color:var(--or);color:var(--blanc)}
.progress-step .label{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gris-texte);text-align:center;max-width:90px}
.progress-step.active .label{color:var(--noir);font-weight:500}

.devis-step{display:none;animation:fadeIn .5s var(--transition)}
.devis-step.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

.devis-step h3{font-size:1.6rem;margin-bottom:12px;text-align:center}
.devis-step .question{font-size:.95rem;color:var(--gris-texte);text-align:center;margin-bottom:32px}

.choix-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px}
.choix-grid.deux{grid-template-columns:repeat(2,1fr)}
.choix{padding:24px 18px;border:1.5px solid rgba(26,26,26,0.1);text-align:center;cursor:pointer;transition:all .3s var(--transition);background:var(--ivoire-clair)}
.choix:hover{border-color:var(--or);background:var(--blanc)}
.choix.selected{border-color:var(--or);background:rgba(184,152,90,0.06)}
.choix .pict{font-size:1.6rem;color:var(--or);margin-bottom:10px}
.choix .titre{font-size:.95rem;font-weight:500;color:var(--noir);margin-bottom:4px}
.choix .desc{font-size:.78rem;color:var(--gris-texte)}

.devis-input{width:100%;padding:14px 18px;border:1px solid rgba(26,26,26,0.15);background:var(--ivoire-clair);font-family:inherit;font-size:.95rem;margin-bottom:16px;transition:border-color .3s}
.devis-input:focus{outline:none;border-color:var(--or);background:var(--blanc)}
.devis-label{display:block;font-size:.82rem;color:var(--gris-texte);margin-bottom:8px;letter-spacing:.04em}
.devis-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}

.devis-actions{display:flex;justify-content:space-between;gap:16px;margin-top:32px;padding-top:32px;border-top:1px solid rgba(26,26,26,0.08)}
.btn-devis{padding:14px 32px;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:all .35s var(--transition);border:1px solid}
.btn-devis-prev{background:transparent;color:var(--gris-texte);border-color:rgba(26,26,26,0.15)}
.btn-devis-prev:hover{color:var(--noir);border-color:var(--noir)}
.btn-devis-next{background:var(--noir);color:var(--ivoire);border-color:var(--noir);margin-left:auto}
.btn-devis-next:hover{background:var(--or);border-color:var(--or)}
.btn-devis-next:disabled{opacity:.4;cursor:not-allowed}

.resultat{text-align:center;padding:30px 0}
.resultat-prix{font-family:'Cormorant Garamond',serif;font-size:4rem;color:var(--noir);line-height:1;margin:20px 0}
.resultat-prix .euro{font-size:2rem;color:var(--or);vertical-align:top}
.resultat-prix .per{font-size:1.2rem;color:var(--gris-texte);font-family:'Inter',sans-serif}
.resultat .badge-or{display:inline-block;padding:6px 16px;background:rgba(184,152,90,0.12);color:var(--or-fonce);font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;margin-bottom:10px}

.faq{background:var(--ivoire-clair)}
.faq-list{max-width:820px;margin:0 auto}
.faq-item{border-bottom:1px solid rgba(184,152,90,0.2);transition:all .3s var(--transition)}
.faq-question{padding:28px 0;cursor:pointer;display:flex;justify-content:space-between;align-items:center;color:var(--noir);font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:500}
.faq-question .plus{font-size:1.5rem;color:var(--or);transition:transform .4s var(--transition);font-weight:300}
.faq-item.open .faq-question .plus{transform:rotate(45deg)}
.faq-reponse{max-height:0;overflow:hidden;transition:max-height .5s var(--transition);color:var(--gris-texte);font-size:.95rem;line-height:1.8}
.faq-reponse-inner{padding:0 0 28px}
.faq-item.open .faq-reponse{max-height:500px}

.cta-final{background:var(--ivoire);text-align:center;padding:120px 0;position:relative}
.cta-final h2{margin-bottom:24px}
.cta-final h2 em{color:var(--or);font-style:italic}
.cta-final p{font-size:1.1rem;color:var(--gris-texte);max-width:560px;margin:0 auto 40px}

.footer{background:var(--noir);color:var(--ivoire-fonce);padding:80px 0 30px}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:50px;margin-bottom:60px}
.footer-brand .logo-footer{height:90px;margin-bottom:20px}
.footer-brand .logo-footer img{height:100%;width:auto;object-fit:contain}
.footer-brand p{font-size:.92rem;color:rgba(245,241,232,0.6);max-width:300px;line-height:1.7}
.footer h5{font-family:'Cormorant Garamond',serif;font-size:1.15rem;color:var(--or);margin-bottom:24px;font-style:italic}
.footer ul{list-style:none}
.footer li{margin-bottom:12px;font-size:.9rem}
.footer a{color:rgba(245,241,232,0.6);transition:color .3s}
.footer a:hover{color:var(--or)}
.footer-contact-item{display:flex;align-items:flex-start;gap:10px;margin-bottom:14px;font-size:.88rem;color:rgba(245,241,232,0.6)}
.footer-contact-item svg{flex-shrink:0;color:var(--or);margin-top:3px}
.footer-bottom{padding-top:30px;border-top:1px solid rgba(184,152,90,0.15);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;font-size:.82rem;color:rgba(245,241,232,0.5)}
.footer-legal{display:flex;gap:24px;flex-wrap:wrap}
.footer .signature{font-style:italic;color:var(--or);font-family:'Cormorant Garamond',serif;font-size:.95rem;letter-spacing:.04em}

@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:60px}
  .hero-visual{height:480px}
  .offres-grid,.pourquoi-grid,.temoignages-grid{grid-template-columns:1fr;gap:24px}
  .offre.populaire{transform:none}
  .offre.populaire:hover{transform:translateY(-8px)}
  .processus-timeline{grid-template-columns:1fr 1fr;gap:40px}
  .processus-timeline::before{display:none}
  .confiance-grid{grid-template-columns:1fr 1fr;gap:30px}
  .footer-grid{grid-template-columns:1fr 1fr;gap:40px}
  .nav{display:none}
  .menu-mobile{display:block}
  .nav.open{display:flex;position:absolute;top:80px;left:0;right:0;background:var(--ivoire);flex-direction:column;padding:30px;border-top:1px solid rgba(184,152,90,0.15)}
  .devis-card{padding:40px 30px}
  .choix-grid{grid-template-columns:1fr;gap:12px}
  .devis-row{grid-template-columns:1fr}
  .progress-step .label{display:none}
  .section{padding:80px 0}
}
@media (max-width:520px){
  .container{padding:0 20px}
  .hero{padding:120px 0 60px}
  .footer-grid{grid-template-columns:1fr}
  .confiance-grid{grid-template-columns:1fr}
  .processus-timeline{grid-template-columns:1fr}
  .hero-cta{flex-direction:column}
  .hero-cta .btn-primaire,.hero-cta .btn-secondaire{width:100%;justify-content:center}
}

@media (prefers-reduced-motion:reduce){*{animation-duration:0.01ms !important;transition-duration:0.01ms !important}}
:focus-visible{outline:2px solid var(--or);outline-offset:3px}
</style>
</head>
<body>

<header class="header">
  <div class="container">
    <div class="header-inner">
      <a href="#" class="logo" aria-label="PME CONSULTANCE - Accueil">
        <img src="assets/pme-lateral-blanc.png" alt="PME CONSULTANCE" />
      </a>
      <nav class="nav" id="nav">
        <a href="#offres">Nos offres</a>
        <a href="#pourquoi">Pourquoi nous</a>
        <a href="#processus">Comment ça marche</a>
        <a href="#temoignages">Témoignages</a>
        <a href="#faq">FAQ</a>
        <a href="#devis" class="btn-header">Devis en 60s</a>
      </nav>
      <button class="menu-mobile" id="menuToggle" aria-label="Menu">☰</button>
    </div>
  </div>
</header>

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <span class="hero-eyebrow">Cabinet d'expertise comptable · 100% en ligne</span>
        <h1>L'expertise comptable <em>premium</em>,<br/>au prix juste.</h1>
        <p class="hero-sous">
          PME CONSULTANCE accompagne les entrepreneurs, micro-entrepreneurs et TPE françaises avec des forfaits transparents, un expert dédié et des outils digitaux haut de gamme. <em class="italique">Expertise · Conseils · Disruption · Valeur Ajoutée.</em>
        </p>
        <div class="hero-cta">
          <a href="#devis" class="btn-primaire">Obtenir mon devis en 60s<span class="arrow">→</span></a>
          <a href="#offres" class="btn-secondaire">Découvrir nos offres</a>
        </div>
        <div class="hero-trust">
          <div class="hero-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 L3 6 v6 c0 5 4 10 9 10 5 0 9-5 9-10 V6 z"/></svg>
            Inscrit à l'Ordre des Experts-Comptables
          </div>
          <div class="hero-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Devis gratuit & sans engagement
          </div>
          <div class="hero-trust-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Réponse sous 24h
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card hero-card-1">
          <div class="num">60s</div>
          <div class="label">Devis instantané</div>
          <div class="desc">Calculez votre tarif personnalisé en moins d'une minute.</div>
        </div>
        <div class="hero-card hero-card-3">
          <div class="num">-40%</div>
          <div class="label">vs. cabinet traditionnel</div>
          <div class="desc">Tarifs maîtrisés grâce à notre modèle 100% digital.</div>
        </div>
        <div class="hero-card hero-card-2">
          <div class="num">★ 4,9/5</div>
          <div class="label">Satisfaction client</div>
          <div class="desc">Plus de 250 entrepreneurs nous font confiance.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="confiance">
  <div class="container">
    <div class="confiance-grid">
      <div class="confiance-item"><div class="pict">⚖</div><h4>Ordre Experts-Comptables</h4><p>Cabinet inscrit & assuré</p></div>
      <div class="confiance-item"><div class="pict">🔒</div><h4>Données sécurisées</h4><p>Hébergement RGPD France</p></div>
      <div class="confiance-item"><div class="pict">⚡</div><h4>Réponse 24h max.</h4><p>Expert dédié à votre dossier</p></div>
      <div class="confiance-item"><div class="pict">€</div><h4>Tarifs transparents</h4><p>Sans surprise, sans engagement</p></div>
    </div>
  </div>
</section>

<section class="section offres" id="offres">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre">Nos forfaits</span>
      <h2>Trois packs taillés pour les <em class="italique">entrepreneurs exigeants</em></h2>
      <p>Des prix transparents, tout inclus. Pas de mauvaise surprise, jamais.</p>
    </div>

    <div class="offres-grid">
      <div class="offre">
        <div class="offre-icone">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 12h1M9 15h1M14 9h1M14 12h1M14 15h1"/></svg>
        </div>
        <h3>Pack Création d'entreprise</h3>
        <p class="accroche">De l'idée aux statuts en 7 jours, clé en main.</p>
        <div class="prix">
          <div class="prix-montant"><span class="euro">€</span>490<span class="periode">forfait unique</span></div>
          <p class="prix-mention">+ frais de greffe & annonces légales</p>
        </div>
        <ul>
          <li>Choix de la forme juridique (SASU, SAS, SARL, EURL)</li>
          <li>Rédaction des statuts personnalisés</li>
          <li>Dépôt du capital social</li>
          <li>Immatriculation au RCS</li>
          <li>Conseil fiscal & social initial</li>
          <li>1h de coaching avec votre expert dédié</li>
        </ul>
        <button class="btn-offre" data-pack="creation">Souscrire ce pack</button>
      </div>

      <div class="offre populaire">
        <div class="badge">Le plus choisi</div>
        <div class="offre-icone">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0116 0v1"/></svg>
        </div>
        <h3>Pack Micro-entrepreneur</h3>
        <p class="accroche">L'accompagnement complet de votre micro-entreprise au quotidien.</p>
        <div class="prix">
          <div class="prix-montant"><span class="euro">€</span>39<span class="periode">/ mois HT</span></div>
          <p class="prix-mention">Engagement annuel · Sans surcoût</p>
        </div>
        <ul>
          <li>Déclarations URSSAF mensuelles ou trimestrielles</li>
          <li>Déclarations TVA si applicable</li>
          <li>Suivi du seuil de chiffre d'affaires</li>
          <li>Tableau de bord temps réel</li>
          <li>Conseils fiscaux illimités par chat</li>
          <li>Optimisation cotisations sociales</li>
          <li>Déclaration revenus 2042-C-PRO incluse</li>
        </ul>
        <button class="btn-offre" data-pack="micro">Souscrire ce pack</button>
      </div>

      <div class="offre">
        <div class="offre-icone">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h18v18H3zM9 9h6v6H9zM3 9h6M15 9h6M9 3v6M9 15v6"/></svg>
        </div>
        <h3>Pack Bilan annuel TPE</h3>
        <p class="accroche">Vos comptes annuels établis par un expert, à prix forfaitaire.</p>
        <div class="prix">
          <div class="prix-montant"><span class="euro">€</span>890<span class="periode">/ an HT</span></div>
          <p class="prix-mention">À partir de · selon volumétrie</p>
        </div>
        <ul>
          <li>Établissement du bilan comptable</li>
          <li>Compte de résultat & annexes</li>
          <li>Liasse fiscale complète (2050 et suivantes)</li>
          <li>Télétransmission EDI</li>
          <li>Dépôt au greffe</li>
          <li>Rendez-vous bilan & conseils stratégiques</li>
          <li>Optimisation fiscale</li>
        </ul>
        <button class="btn-offre" data-pack="bilan">Souscrire ce pack</button>
      </div>
    </div>

    <p class="offres-note">
      Besoin d'un accompagnement sur-mesure (PME, holding, restructuration) ? <a href="#devis">Demandez un devis personnalisé →</a>
    </p>
  </div>
</section>

<section class="section pourquoi" id="pourquoi">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre" style="color:var(--or)">Notre différence</span>
      <h2>Pourquoi <em class="italique">PME CONSULTANCE</em> ?</h2>
      <p>Trois engagements qui changent radicalement l'expérience comptable.</p>
    </div>
    <div class="pourquoi-grid">
      <div class="pourquoi-item">
        <div class="num">01</div>
        <h3>Un expert dédié</h3>
        <p>Pas de plateforme anonyme. Un expert-comptable diplômé suit votre dossier de A à Z, vous le connaissez par son prénom et il connaît votre activité.</p>
      </div>
      <div class="pourquoi-item">
        <div class="num">02</div>
        <h3>100% digital, 0% bureaucratie</h3>
        <p>Espace client sécurisé, signature électronique, échanges fluides par chat ou visio. Vous gagnez un temps précieux pour ce qui compte vraiment : votre activité.</p>
      </div>
      <div class="pourquoi-item">
        <div class="num">03</div>
        <h3>Tarifs justes & transparents</h3>
        <p>Forfaits annoncés à l'avance, sans surprise. Notre modèle digital nous permet de vous offrir une expertise premium à un tarif jusqu'à 40% inférieur aux cabinets traditionnels.</p>
      </div>
    </div>
  </div>
</section>

<section class="section processus" id="processus">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre">Comment ça marche</span>
      <h2>Quatre étapes vers la <em class="italique">sérénité</em></h2>
      <p>Du premier clic à votre bilan annuel, un parcours pensé pour votre confort.</p>
    </div>
    <div class="processus-timeline">
      <div class="etape"><div class="cercle">I</div><h4>Devis instantané</h4><p>Remplissez notre formulaire en 60 secondes et obtenez votre tarif personnalisé.</p></div>
      <div class="etape"><div class="cercle">II</div><h4>Visio de cadrage</h4><p>30 minutes avec votre expert pour valider vos besoins et signer la lettre de mission.</p></div>
      <div class="etape"><div class="cercle">III</div><h4>Mise en route</h4><p>Accès à votre espace client, transmission des pièces et démarrage immédiat.</p></div>
      <div class="etape"><div class="cercle">IV</div><h4>Accompagnement continu</h4><p>Production comptable, conseils, alertes proactives. Vous vous concentrez sur votre activité.</p></div>
    </div>
  </div>
</section>

<section class="section temoignages" id="temoignages">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre">Ils nous font confiance</span>
      <h2>La parole à <em class="italique">nos clients</em></h2>
      <p>Plus de 250 entrepreneurs accompagnés. Voici ce qu'ils en pensent.</p>
    </div>
    <div class="temoignages-grid">
      <div class="temoignage">
        <div class="etoiles">★ ★ ★ ★ ★</div>
        <p>Une expertise comptable enfin lisible. J'ai signé en moins d'une heure, et depuis je dors tranquille. Mon expert me prévient avant chaque échéance.</p>
        <div class="auteur"><div class="avatar">CL</div><div><div class="nom">Camille L.</div><div class="role">Consultante en stratégie · SASU</div></div></div>
      </div>
      <div class="temoignage">
        <div class="etoiles">★ ★ ★ ★ ★</div>
        <p>Le rapport qualité-prix est imbattable. J'avais peur en passant chez un cabinet 100% en ligne. En réalité, c'est plus humain que mon ancien expert "physique".</p>
        <div class="auteur"><div class="avatar">TM</div><div><div class="nom">Thomas M.</div><div class="role">Artisan menuisier · Micro-entreprise</div></div></div>
      </div>
      <div class="temoignage">
        <div class="etoiles">★ ★ ★ ★ ★</div>
        <p>Création de ma SAS en 6 jours, accompagnement irréprochable. Pascal a su m'éviter plusieurs erreurs de débutant. Je recommande les yeux fermés.</p>
        <div class="auteur"><div class="avatar">SD</div><div><div class="nom">Sophie D.</div><div class="role">Fondatrice agence digitale · SAS</div></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section devis" id="devis">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre">Votre devis personnalisé</span>
      <h2>Découvrez votre tarif en <em class="italique">moins de 60 secondes</em></h2>
      <p>Un calcul transparent, sans engagement, basé sur votre situation réelle.</p>
    </div>

    <div class="devis-card">
      <div class="devis-progress">
        <div class="devis-progress-fill" id="progressFill" style="width:0%"></div>
        <div class="progress-step active" data-step="1"><div class="puce">1</div><div class="label">Activité</div></div>
        <div class="progress-step" data-step="2"><div class="puce">2</div><div class="label">Volume</div></div>
        <div class="progress-step" data-step="3"><div class="puce">3</div><div class="label">Options</div></div>
        <div class="progress-step" data-step="4"><div class="puce">4</div><div class="label">Contact</div></div>
        <div class="progress-step" data-step="5"><div class="puce">✓</div><div class="label">Devis</div></div>
      </div>

      <div class="devis-step active" data-step="1">
        <h3>Quel est votre besoin ?</h3>
        <p class="question">Sélectionnez l'offre qui correspond à votre situation.</p>
        <div class="choix-grid">
          <div class="choix" data-value="creation"><div class="pict">🏛</div><div class="titre">Création d'entreprise</div><div class="desc">Lancer une nouvelle structure</div></div>
          <div class="choix" data-value="micro"><div class="pict">👤</div><div class="titre">Micro-entrepreneur</div><div class="desc">Suivi annuel & déclarations</div></div>
          <div class="choix" data-value="bilan"><div class="pict">📊</div><div class="titre">Bilan annuel TPE</div><div class="desc">Comptes annuels & liasse</div></div>
        </div>
        <div class="devis-actions"><button class="btn-devis btn-devis-next" disabled>Suivant →</button></div>
      </div>

      <div class="devis-step" data-step="2">
        <h3>Votre volumétrie</h3>
        <p class="question" id="step2Question">Pour affiner votre devis, indiquez votre niveau d'activité.</p>
        <div class="choix-grid" id="step2Choices"></div>
        <div class="devis-actions">
          <button class="btn-devis btn-devis-prev">← Retour</button>
          <button class="btn-devis btn-devis-next" disabled>Suivant →</button>
        </div>
      </div>

      <div class="devis-step" data-step="3">
        <h3>Options complémentaires</h3>
        <p class="question">Sélectionnez les services additionnels souhaités (optionnel).</p>
        <div class="choix-grid deux" id="step3Options"></div>
        <div class="devis-actions">
          <button class="btn-devis btn-devis-prev">← Retour</button>
          <button class="btn-devis btn-devis-next">Suivant →</button>
        </div>
      </div>

      <div class="devis-step" data-step="4">
        <h3>Vos coordonnées</h3>
        <p class="question">Pour vous transmettre votre devis et confirmer votre tarif.</p>
        <div class="devis-row">
          <div><label class="devis-label">Prénom *</label><input type="text" class="devis-input" id="prenom" required /></div>
          <div><label class="devis-label">Nom *</label><input type="text" class="devis-input" id="nom" required /></div>
        </div>
        <label class="devis-label">Email *</label>
        <input type="email" class="devis-input" id="email" required />
        <label class="devis-label">Téléphone *</label>
        <input type="tel" class="devis-input" id="telephone" required />
        <label class="devis-label">Nom de votre activité (optionnel)</label>
        <input type="text" class="devis-input" id="entreprise" />
        <div class="devis-actions">
          <button class="btn-devis btn-devis-prev">← Retour</button>
          <button class="btn-devis btn-devis-next" id="btnDevisFinal">Calculer mon devis →</button>
        </div>
      </div>

      <div class="devis-step" data-step="5">
        <div class="resultat">
          <div class="badge-or">Votre devis personnalisé</div>
          <h3 id="resultatTitre">Votre tarif estimé</h3>
          <div class="resultat-prix" id="resultatPrix">
            <span class="euro">€</span><span id="resultatMontant">0</span><span class="per" id="resultatPeriode"></span>
          </div>
          <p style="color:var(--gris-texte);max-width:480px;margin:20px auto;font-size:.95rem">
            Votre devis détaillé vient de vous être envoyé par email. Un expert PME CONSULTANCE vous contactera sous <strong>24h</strong> pour valider votre projet.
          </p>
          <div style="display:flex;gap:14px;justify-content:center;margin-top:30px;flex-wrap:wrap">
            <a href="mailto:contact@pmeconsultance.fr" class="btn-primaire" style="font-size:.85rem;padding:14px 28px">Prendre RDV directement</a>
            <button class="btn-secondaire" onclick="resetDevis()" style="font-size:.85rem;padding:14px 28px">Refaire un devis</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section faq" id="faq">
  <div class="container">
    <div class="section-titre">
      <span class="surtitre">Questions fréquentes</span>
      <h2>Tout ce que vous voulez <em class="italique">savoir</em></h2>
      <p>Les réponses aux questions les plus posées par nos prospects.</p>
    </div>
    <div class="faq-list">
      <div class="faq-item"><div class="faq-question">PME CONSULTANCE est-il un cabinet officiellement reconnu ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Oui, PME CONSULTANCE est un cabinet d'expertise comptable inscrit au tableau de l'Ordre des Experts-Comptables, avec une assurance responsabilité civile professionnelle conforme. Tous nos collaborateurs experts sont diplômés du DEC (Diplôme d'Expertise Comptable).</div></div></div>
      <div class="faq-item"><div class="faq-question">Comment se passe l'accompagnement à 100% à distance ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Vous disposez d'un espace client sécurisé pour transmettre vos pièces. Les échanges se font par messagerie sécurisée, email ou visio selon vos préférences. Un expert dédié connaît votre dossier, ce n'est pas un système de tickets anonyme. Vous pouvez le joindre directement par téléphone si besoin.</div></div></div>
      <div class="faq-item"><div class="faq-question">Pourquoi vos tarifs sont-ils inférieurs à un cabinet classique ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Notre modèle 100% digital nous permet de réduire les coûts de structure (locaux, déplacements, papier). Nous automatisons les tâches répétitives à faible valeur ajoutée pour concentrer le temps de nos experts sur le conseil. Le résultat : une expertise premium à un tarif jusqu'à 40% inférieur, sans rogner sur la qualité.</div></div></div>
      <div class="faq-item"><div class="faq-question">Puis-je changer d'offre en cours d'année ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Bien sûr. Si votre activité évolue (passage de micro-entreprise à société, dépassement de seuils...), nous adaptons votre forfait avec un avenant à la lettre de mission. Aucun changement n'est facturé tant qu'il intervient en cours d'année et reste cohérent avec votre activité réelle.</div></div></div>
      <div class="faq-item"><div class="faq-question">Est-ce que je peux résilier facilement ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Oui, vous pouvez résilier votre lettre de mission à tout moment avec un préavis de 3 mois (durée minimale légale). Aucune clause cachée, aucun frais de sortie. Nous transmettons votre dossier au confrère de votre choix dans les meilleures conditions.</div></div></div>
      <div class="faq-item"><div class="faq-question">Comment sont sécurisées mes données comptables ?<span class="plus">+</span></div><div class="faq-reponse"><div class="faq-reponse-inner">Vos données sont hébergées en France sur des serveurs certifiés ISO 27001, chiffrées à la fois en transit (TLS 1.3) et au repos (AES-256). Nous sommes conformes au RGPD et au secret professionnel imposé par l'Ordre des Experts-Comptables. Vous restez seul propriétaire de vos données.</div></div></div>
    </div>
  </div>
</section>

<section class="cta-final">
  <div class="container">
    <span class="surtitre" style="color:var(--or);font-size:.78rem;letter-spacing:.32em;text-transform:uppercase;font-weight:500;display:block;margin-bottom:18px">Prêt à franchir le pas ?</span>
    <h2>Reprenez le contrôle de <em>votre comptabilité</em></h2>
    <p>Devis instantané, expert dédié, sans engagement. Plus de 250 entrepreneurs nous font déjà confiance.</p>
    <a href="#devis" class="btn-primaire">Obtenir mon devis maintenant <span class="arrow">→</span></a>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo-footer"><img src="assets/PMC_logo_horizontal.png" alt="PME CONSULTANCE" /></div>
        <p>Cabinet d'expertise comptable & de conseil 100% en ligne, dédié aux entrepreneurs, micro-entrepreneurs et TPE françaises.</p>
        <p class="signature" style="margin-top:18px">Expertise · Conseils · Disruption · Valeur Ajoutée</p>
      </div>
      <div>
        <h5>Nos offres</h5>
        <ul>
          <li><a href="#offres">Pack Création d'entreprise</a></li>
          <li><a href="#offres">Pack Micro-entrepreneur</a></li>
          <li><a href="#offres">Pack Bilan annuel TPE</a></li>
          <li><a href="#devis">Devis sur-mesure</a></li>
        </ul>
      </div>
      <div>
        <h5>Le cabinet</h5>
        <ul>
          <li><a href="#pourquoi">Notre méthode</a></li>
          <li><a href="#processus">Comment ça marche</a></li>
          <li><a href="#temoignages">Témoignages</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h5>Contact</h5>
        <div class="footer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>
          <span>contact@pmeconsultance.fr</span>
        </div>
        <div class="footer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          <span>Sur rendez-vous uniquement</span>
        </div>
        <div class="footer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>France entière · 100% en ligne</span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© 2026 PME CONSULTANCE — Cabinet inscrit à l'Ordre des Experts-Comptables</div>
      <div class="footer-legal">
        <a href="#">Mentions légales</a>
        <a href="#">CGV</a>
        <a href="#">Politique de confidentialité</a>
        <a href="#">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<script>
document.getElementById('menuToggle').addEventListener('click',()=>{document.getElementById('nav').classList.toggle('open')});
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{document.getElementById('nav').classList.remove('open')}));

window.addEventListener('scroll',()=>{
  const h=document.querySelector('.header');
  if(window.scrollY>30) h.style.boxShadow='0 2px 20px rgba(26,26,26,0.06)';
  else h.style.boxShadow='none';
});

document.querySelectorAll('.faq-item').forEach(item=>{
  item.querySelector('.faq-question').addEventListener('click',()=>{
    const wasOpen=item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
    if(!wasOpen) item.classList.add('open');
  });
});

document.querySelectorAll('.btn-offre').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const pack=btn.dataset.pack;
    document.querySelector('#devis').scrollIntoView({behavior:'smooth'});
    setTimeout(()=>{
      const choix=document.querySelector(`.devis-step[data-step="1"] .choix[data-value="${pack}"]`);
      if(choix){choix.click();setTimeout(()=>document.querySelector('.devis-step.active .btn-devis-next').click(),300)}
    },800);
  });
});

const PACKS={
  creation:{nom:"Pack Création d'entreprise",base:490,periode:'forfait unique',question:'Quelle forme juridique envisagez-vous ?',
    volumes:[{label:'Micro-entreprise',desc:'Auto-entrepreneur',value:'micro',mult:0.5},{label:'EURL / SASU',desc:'Société unipersonnelle',value:'unip',mult:1},{label:'SARL / SAS',desc:'Plusieurs associés',value:'multi',mult:1.3}],
    options:[{label:'Domiciliation 12 mois',desc:'Adresse pro en France',prix:240},{label:"Pacte d'associés",desc:'Clauses sur-mesure',prix:350},{label:'Compte pro inclus',desc:'Partenaire bancaire',prix:0,gratuit:true},{label:'Coaching stratégique 2h',desc:'Avec un expert dédié',prix:180}]},
  micro:{nom:'Pack Micro-entrepreneur',base:39,periode:'/ mois HT',question:"Quel est votre chiffre d'affaires annuel prévisionnel ?",
    volumes:[{label:'< 25 000 €',desc:'Activité débutante',value:'s',mult:0.85},{label:'25 000 € - 60 000 €',desc:'Activité régulière',value:'m',mult:1},{label:'> 60 000 €',desc:'Activité soutenue',value:'l',mult:1.4}],
    options:[{label:'Suivi TVA',desc:'Si vous dépassez les seuils',prix:15,periode:' / mois'},{label:'Tableau de bord premium',desc:'KPI temps réel',prix:9,periode:' / mois'},{label:'Déclaration revenus 2042',desc:'Incluse',prix:0,gratuit:true},{label:'Bilan annuel express',desc:'Synthèse fiscale',prix:120,periode:' / an'}]},
  bilan:{nom:'Pack Bilan annuel TPE',base:890,periode:'/ an HT',question:"Quel est votre chiffre d'affaires annuel ?",
    volumes:[{label:'< 100 K€',desc:'Très petite structure',value:'s',mult:1},{label:'100 K€ - 500 K€',desc:'TPE en croissance',value:'m',mult:1.6},{label:'> 500 K€',desc:'PME établie',value:'l',mult:2.4}],
    options:[{label:'Tenue comptable mensuelle',desc:'Saisie des pièces',prix:1200,periode:' / an'},{label:'Gestion paie (1-3 salariés)',desc:'Bulletins & DSN',prix:780,periode:' / an'},{label:'Conseil fiscal trimestriel',desc:'4 RDV/an',prix:480,periode:' / an'},{label:'Reporting CAC',desc:'Si éligible',prix:600,periode:' / an'}]}
};

let etat={pack:null,volume:null,options:[],contact:{}};
let etapeActuelle=1;

function majProgress(){
  const fill=document.getElementById('progressFill');
  const total=5;
  const pct=((etapeActuelle-1)/(total-1))*100;
  fill.style.width=`calc(${pct}% - ${pct/100*16}px)`;
  document.querySelectorAll('.progress-step').forEach(s=>{
    s.classList.remove('active','done');
    const n=parseInt(s.dataset.step);
    if(n<etapeActuelle) s.classList.add('done');
    if(n===etapeActuelle) s.classList.add('active');
  });
}

function allerEtape(n){
  document.querySelectorAll('.devis-step').forEach(s=>s.classList.remove('active'));
  document.querySelector(`.devis-step[data-step="${n}"]`).classList.add('active');
  etapeActuelle=n;
  majProgress();
  if(n===2) genererEtape2();
  if(n===3) genererEtape3();
  if(n===5) calculerDevis();
}

document.querySelectorAll('.devis-step[data-step="1"] .choix').forEach(c=>{
  c.addEventListener('click',()=>{
    document.querySelectorAll('.devis-step[data-step="1"] .choix').forEach(x=>x.classList.remove('selected'));
    c.classList.add('selected');
    etat.pack=c.dataset.value;
    etat.volume=null;etat.options=[];
    document.querySelector('.devis-step[data-step="1"] .btn-devis-next').disabled=false;
  });
});

function genererEtape2(){
  const pack=PACKS[etat.pack];
  document.getElementById('step2Question').textContent=pack.question;
  const cont=document.getElementById('step2Choices');
  cont.innerHTML='';
  pack.volumes.forEach(v=>{
    const div=document.createElement('div');
    div.className='choix';
    div.dataset.value=v.value;
    div.innerHTML=`<div class="titre">${v.label}</div><div class="desc">${v.desc}</div>`;
    div.addEventListener('click',()=>{
      cont.querySelectorAll('.choix').forEach(x=>x.classList.remove('selected'));
      div.classList.add('selected');
      etat.volume=v;
      document.querySelector('.devis-step[data-step="2"] .btn-devis-next').disabled=false;
    });
    cont.appendChild(div);
  });
  document.querySelector('.devis-step[data-step="2"] .btn-devis-next').disabled=true;
}

function genererEtape3(){
  const pack=PACKS[etat.pack];
  const cont=document.getElementById('step3Options');
  cont.innerHTML='';
  pack.options.forEach((o,i)=>{
    const div=document.createElement('div');
    div.className='choix';
    div.dataset.idx=i;
    const prix=o.gratuit?'<strong style="color:var(--or)">Inclus</strong>':`+ ${o.prix}€${o.periode||''}`;
    div.innerHTML=`<div class="titre">${o.label}</div><div class="desc">${o.desc}</div><div style="margin-top:10px;font-size:.78rem;color:var(--gris-texte)">${prix}</div>`;
    div.addEventListener('click',()=>{
      div.classList.toggle('selected');
      const idx=parseInt(div.dataset.idx);
      if(div.classList.contains('selected')){if(!etat.options.includes(idx)) etat.options.push(idx)}
      else{etat.options=etat.options.filter(x=>x!==idx)}
    });
    cont.appendChild(div);
  });
}

document.querySelectorAll('.btn-devis-next').forEach(btn=>{
  btn.addEventListener('click',()=>{
    if(etapeActuelle===4){
      const champs=['prenom','nom','email','telephone'];
      let ok=true;
      champs.forEach(c=>{
        const inp=document.getElementById(c);
        if(!inp.value.trim()){inp.style.borderColor='#c44';ok=false}
        else inp.style.borderColor='';
        etat.contact[c]=inp.value.trim();
      });
      etat.contact.entreprise=document.getElementById('entreprise').value.trim();
      if(!ok) return;
    }
    if(etapeActuelle<5) allerEtape(etapeActuelle+1);
  });
});
document.querySelectorAll('.btn-devis-prev').forEach(btn=>{btn.addEventListener('click',()=>{if(etapeActuelle>1) allerEtape(etapeActuelle-1)})});

function calculerDevis(){
  const pack=PACKS[etat.pack];
  let total=Math.round(pack.base*(etat.volume?etat.volume.mult:1));
  let bonus=0;
  etat.options.forEach(idx=>{const o=pack.options[idx];if(!o.gratuit) bonus+=o.prix});
  document.getElementById('resultatTitre').textContent=`Votre ${pack.nom}`;
  document.getElementById('resultatMontant').textContent=total;
  document.getElementById('resultatPeriode').textContent=' '+pack.periode;
  const c=document.querySelector('.resultat');
  const old=c.querySelector('.options-note');
  if(old) old.remove();
  if(bonus>0){
    const note=document.createElement('p');
    note.style.cssText='color:var(--gris-texte);font-size:.92rem;margin-top:-10px';
    note.innerHTML=`<em>Options additionnelles : <strong>+${bonus}€</strong></em>`;
    note.classList.add('options-note');
    c.querySelector('.resultat-prix').after(note);
  }
}

function resetDevis(){
  etat={pack:null,volume:null,options:[],contact:{}};
  document.querySelectorAll('.choix').forEach(c=>c.classList.remove('selected'));
  document.querySelectorAll('.devis-input').forEach(i=>{i.value='';i.style.borderColor=''});
  const old=document.querySelector('.options-note');if(old) old.remove();
  allerEtape(1);
  document.querySelectorAll('.btn-devis-next').forEach((b,i)=>{if(i===0||i===1) b.disabled=true});
}

majProgress();
</script>

</body>
</html>
